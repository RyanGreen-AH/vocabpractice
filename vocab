                    { id: '2', word: "Hypothesis", pos: "noun", definition: "A testable prediction based on observation and reasoning.", hint: "If/Then statement", example: "Our hypothesis was that plants with sunlight would grow faster." },
                    { id: '3', word: "Photosynthesis", pos: "noun", definition: "Process by which green plants turn sunlight into energy.", hint: "Requires chlorophyll", example: "Plants generate oxygen during photosynthesis." },
                    { id: '4', word: "Symbiosis", pos: "noun", definition: "A close relationship between two different species.", hint: "e.g., Bees and flowers", example: "Clownfish and sea anemones live in symbiosis." },
                    { id: '5', word: "Chronological", pos: "adjective", definition: "Arranged in order of time occurrence from first to last.", hint: "Timeline order", example: "The history textbook listed events in chronological order." }
                ]
            },
            science: {
                title: "🔬 Earth & Space Science",
                description: "Geology and atmospheric science terms.",
                classCode: "parsons-sci",
                cards: [
                    { id: '1', word: "Atmosphere", pos: "noun", definition: "The blanket of gases surrounding a planet.", hint: "Protects from space radiation", example: "Earth's atmosphere contains nitrogen and oxygen." },
                    { id: '2', word: "Plate Tectonics", pos: "noun", definition: "Movement of Earth's lithospheric plates.", hint: "Causes earthquakes", example: "Plate tectonics formed the Himalayan mountains." },
                    { id: '3', word: "Erosion", pos: "noun", definition: "Wearing away of rock and soil by wind or water.", hint: "Forms canyons", example: "River water caused gradual soil erosion." }
                ]
            },
