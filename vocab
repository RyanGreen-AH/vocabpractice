<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Middle School Vocabulary Flashcard Generator</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f3ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* 3D Card Flip Animation */
        .perspective-1000 {
            perspective: 1000px;
        }
        .transform-style-3d {
            transform-style: preserve-3d;
            transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .backface-hidden {
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }
        .rotate-y-180 {
            transform: rotateY(180deg);
        }

        /* Printable Sheet Optimization */
        @media print {
            body { background: white !important; color: black !important; }
            .no-print { display: none !important; }
            .print-grid {
                display: grid !important;
                grid-template-columns: repeat(2, 1fr) !important;
                gap: 16px !important;
                page-break-inside: avoid;
            }
            .print-card {
                border: 2px solid #cbd5e1 !important;
                box-shadow: none !important;
                break-inside: avoid;
                padding: 16px !important;
                background: #ffffff !important;
            }
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 4px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col antialiased selection:bg-brand-500 selection:text-white">

    <!-- Top Navigation Header -->
    <header class="no-print bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo & Sync Badge -->
                <div class="flex items-center space-x-3">
                    <div class="bg-gradient-to-tr from-brand-600 to-indigo-500 text-white p-2.5 rounded-xl shadow-md">
                        <i class="fa-solid fa-layer-group text-xl"></i>
                    </div>
                    <div>
                        <div class="flex items-center space-x-2">
                            <span class="text-[11px] font-extrabold uppercase tracking-wider text-brand-600 block leading-tight">Middle School Vocab</span>
                            <!-- Dynamic Sync Indicator -->
                            <span id="sync-status-badge" class="inline-flex items-center space-x-1 bg-emerald-50 text-emerald-700 text-[10px] font-bold px-2 py-0.5 rounded-full border border-emerald-200" title="Sync Status">
                                <span id="sync-status-dot" class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                <span id="sync-status-text">Cloud Sync Ready</span>
                            </span>
                        </div>
                        <h1 id="header-deck-title" class="text-base sm:text-lg font-bold text-slate-900 truncate max-w-[180px] sm:max-w-xs md:max-w-md">
                            Loading Vocabulary Deck...
                        </h1>
                    </div>
                </div>

                <!-- Navigation Tabs -->
                <nav class="hidden md:flex space-x-1 bg-slate-100 p-1 rounded-xl">
                    <button onclick="switchTab('study')" id="nav-btn-study" class="tab-btn px-4 py-2 text-sm font-semibold rounded-lg transition-all flex items-center space-x-2">
                        <i class="fa-solid fa-clone"></i>
                        <span>Flip & Study</span>
                    </button>
                    <button onclick="switchTab('practice')" id="nav-btn-practice" class="tab-btn px-4 py-2 text-sm font-semibold rounded-lg transition-all flex items-center space-x-2">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Practice Mode</span>
                    </button>
                    <button onclick="switchTab('grid')" id="nav-btn-grid" class="tab-btn px-4 py-2 text-sm font-semibold rounded-lg transition-all flex items-center space-x-2">
                        <i class="fa-solid fa-border-all"></i>
                        <span>Grid & Search</span>
                    </button>
                    <button onclick="switchTab('editor')" id="nav-btn-editor" class="tab-btn px-4 py-2 text-sm font-semibold rounded-lg transition-all flex items-center space-x-2">
                        <i id="editor-lock-icon" class="fa-solid fa-lock text-amber-500"></i>
                        <span>Teacher Editor</span>
                    </button>
                    <button onclick="switchTab('embed')" id="nav-btn-embed" class="tab-btn px-4 py-2 text-sm font-semibold rounded-lg transition-all flex items-center space-x-2">
                        <i class="fa-solid fa-code"></i>
                        <span>Share & Embed</span>
                    </button>
                </nav>

                <!-- Action Controls -->
                <div class="flex items-center space-x-2">
                    <button onclick="manualRefreshSync()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 p-2 rounded-xl border border-slate-200 transition-colors" title="Refresh Latest Terms From Teacher">
                        <i class="fa-solid fa-arrows-rotate text-sm"></i>
                    </button>
                    <button id="header-lock-btn" onclick="lockTeacherMode()" class="hidden bg-amber-50 hover:bg-amber-100 text-amber-700 text-xs font-bold py-2 px-3 rounded-xl border border-amber-200 transition-colors flex items-center space-x-1.5">
                        <i class="fa-solid fa-lock"></i>
                        <span class="hidden sm:inline">Lock Editor</span>
                    </button>
                    <button onclick="toggleMobileMenu()" class="md:hidden p-2 text-slate-600 hover:text-slate-900 focus:outline-none">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                    <div class="hidden sm:block">
                        <select id="preset-selector" onchange="loadPresetDeck(this.value)" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold py-2 px-3 rounded-xl border-0 focus:ring-2 focus:ring-brand-500 cursor-pointer">
                            <option value="" disabled selected>✨ Sample Decks</option>
                            <option value="middleSchoolCore">🌟 Core Vocab (7th-8th)</option>
                            <option value="science">🔬 Earth Science</option>
                            <option value="lit">📚 Literary Terms</option>
                            <option value="civics">🏛️ Civics & Social Studies</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mobile Navigation Dropdown -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 py-3 space-y-2">
            <button onclick="switchTab('study'); toggleMobileMenu();" class="w-full text-left px-3 py-2 rounded-lg text-slate-700 font-semibold hover:bg-slate-100 flex items-center space-x-2">
                <i class="fa-solid fa-clone w-5"></i><span>Flip & Study</span>
            </button>
            <button onclick="switchTab('practice'); toggleMobileMenu();" class="w-full text-left px-3 py-2 rounded-lg text-slate-700 font-semibold hover:bg-slate-100 flex items-center space-x-2">
                <i class="fa-solid fa-circle-check w-5"></i><span>Practice Mode</span>
            </button>
            <button onclick="switchTab('grid'); toggleMobileMenu();" class="w-full text-left px-3 py-2 rounded-lg text-slate-700 font-semibold hover:bg-slate-100 flex items-center space-x-2">
                <i class="fa-solid fa-border-all w-5"></i><span>Grid & Search</span>
            </button>
            <button onclick="switchTab('editor'); toggleMobileMenu();" class="w-full text-left px-3 py-2 rounded-lg text-slate-700 font-semibold hover:bg-slate-100 flex items-center space-x-2">
                <i class="fa-solid fa-lock w-5 text-amber-500"></i><span>Teacher Editor</span>
            </button>
            <button onclick="switchTab('embed'); toggleMobileMenu();" class="w-full text-left px-3 py-2 rounded-lg text-slate-700 font-semibold hover:bg-slate-100 flex items-center space-x-2">
                <i class="fa-solid fa-code w-5"></i><span>Share & Embed</span>
            </button>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- Toast Banner Notification -->
        <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
            <div class="bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-2xl flex items-center space-x-3">
                <i id="toast-icon" class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>
                <span id="toast-message" class="text-sm font-semibold">Notification</span>
            </div>
        </div>

        <!-- VIEW 1: FLIP & STUDY MODE -->
        <section id="view-study" class="view-section max-w-3xl mx-auto space-y-5">
            <!-- Search & Control Header -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3">
                <div class="relative w-full sm:w-64">
                    <input type="text" id="study-search-input" onkeyup="filterStudyCards()" placeholder="🔍 Filter cards..." class="w-full pl-9 pr-4 py-2 bg-slate-50 rounded-xl text-xs font-semibold border border-slate-200 focus:outline-none focus:ring-2 focus:ring-brand-500">
                    <i class="fa-solid fa-search absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                </div>

                <div class="flex items-center space-x-2 w-full sm:w-auto justify-between sm:justify-end">
                    <span id="study-counter" class="text-xs font-bold bg-brand-50 text-brand-700 px-3 py-1 rounded-full border border-brand-100">
                        Card 1 / 10
                    </span>
                    <div class="flex items-center space-x-1">
                        <button onclick="shuffleDeck()" title="Shuffle Deck" class="p-2 text-slate-500 hover:text-brand-600 hover:bg-slate-100 rounded-lg transition-colors">
                            <i class="fa-solid fa-shuffle"></i>
                        </button>
                        <button onclick="speakCurrentWord()" title="Listen to Pronunciation" class="p-2 text-slate-500 hover:text-brand-600 hover:bg-slate-100 rounded-lg transition-colors">
                            <i class="fa-solid fa-volume-high"></i>
                        </button>
                        <button onclick="toggleHint()" title="Toggle Hint" class="p-2 text-slate-500 hover:text-amber-500 hover:bg-amber-50 rounded-lg transition-colors">
                            <i class="fa-solid fa-lightbulb"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Progress Bar -->
            <div class="w-full bg-slate-200 rounded-full h-2 overflow-hidden">
                <div id="study-progress-bar" class="bg-brand-600 h-2 rounded-full transition-all duration-300" style="width: 10%"></div>
            </div>

            <!-- 3D Flashcard Container -->
            <div class="perspective-1000 w-full h-[360px] sm:h-[420px] cursor-pointer" onclick="flipCard()">
                <div id="flashcard-inner" class="transform-style-3d relative w-full h-full rounded-3xl shadow-xl transition-all duration-500 bg-white border border-slate-200 hover:shadow-2xl">
                    
                    <!-- Front (Word & Part of Speech) -->
                    <div class="backface-hidden absolute inset-0 w-full h-full p-8 flex flex-col justify-between items-center rounded-3xl bg-gradient-to-b from-white to-slate-50">
                        <div class="w-full flex justify-between items-center">
                            <span id="card-front-pos" class="text-xs font-bold uppercase tracking-wider text-brand-600 bg-brand-50 px-2.5 py-1 rounded-md border border-brand-100">
                                noun
                            </span>
                            <span class="text-xs text-slate-400 font-medium">Click or press Space <i class="fa-solid fa-rotate text-brand-400 ml-1"></i></span>
                        </div>

                        <div class="text-center px-4 my-auto">
                            <h2 id="card-front-word" class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-snug">
                                Vocabulary Word
                            </h2>
                            <div id="card-hint-box" class="mt-4 p-3 bg-amber-50 border border-amber-200 rounded-xl max-w-md mx-auto hidden">
                                <p class="text-[11px] font-bold text-amber-800 uppercase tracking-wide mb-0.5">💡 Teacher Hint</p>
                                <p id="card-hint-text" class="text-xs text-amber-700 font-medium italic"></p>
                            </div>
                        </div>

                        <div class="text-xs text-slate-400 font-semibold flex items-center space-x-1">
                            <i class="fa-solid fa-hand-pointer text-brand-500"></i>
                            <span>Tap card to reveal definition</span>
                        </div>
                    </div>

                    <!-- Back (Definition & Example Sentence) -->
                    <div class="backface-hidden rotate-y-180 absolute inset-0 w-full h-full p-8 flex flex-col justify-between items-center rounded-3xl bg-slate-900 text-white">
                        <div class="w-full flex justify-between items-center">
                            <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 bg-emerald-950/80 px-2.5 py-1 rounded-md border border-emerald-800">Definition</span>
                            <span class="text-xs text-slate-400 font-medium"><i class="fa-solid fa-rotate mr-1"></i> Flip back</span>
                        </div>
                        <div class="text-center px-4 my-auto max-h-[250px] overflow-y-auto space-y-3">
                            <p id="card-back-def" class="text-lg sm:text-2xl font-medium leading-relaxed text-indigo-50">
                                Detailed definition explanation goes here.
                            </p>
                            <p id="card-back-example" class="text-xs sm:text-sm text-slate-300 italic border-t border-slate-800 pt-3 max-w-md mx-auto hidden">
                                "Example sentence using the word."
                            </p>
                        </div>
                        <div class="w-full flex justify-center space-x-4 pt-2">
                            <button onclick="event.stopPropagation(); speakCurrentDef();" class="text-xs text-slate-300 hover:text-white bg-white/10 hover:bg-white/20 px-3.5 py-1.5 rounded-lg transition-colors flex items-center space-x-1.5">
                                <i class="fa-solid fa-volume-high"></i>
                                <span>Read Aloud</span>
                            </button>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Card Navigation Bar -->
            <div class="flex items-center justify-between space-x-4">
                <button onclick="prevCard()" class="flex-1 py-3.5 px-6 rounded-2xl bg-white hover:bg-slate-100 text-slate-700 font-bold border border-slate-200 shadow-sm transition-all flex items-center justify-center space-x-2 active:scale-95">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span class="hidden sm:inline">Previous</span>
                </button>
                <button onclick="flipCard()" class="px-6 py-3.5 rounded-2xl bg-brand-50 hover:bg-brand-100 text-brand-700 font-bold border border-brand-200 transition-all flex items-center justify-center space-x-2 active:scale-95">
                    <i class="fa-solid fa-rotate"></i>
                    <span>Flip</span>
                </button>
                <button onclick="nextCard()" class="flex-1 py-3.5 px-6 rounded-2xl bg-brand-600 hover:bg-brand-700 text-white font-bold shadow-md shadow-brand-500/20 transition-all flex items-center justify-center space-x-2 active:scale-95">
                    <span class="hidden sm:inline">Next</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        </section>

        <!-- VIEW 2: PRACTICE & QUIZ MODE -->
        <section id="view-practice" class="view-section max-w-3xl mx-auto space-y-6 hidden">
            <!-- Score Banner -->
            <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex flex-wrap items-center justify-between gap-4">
                <div>
                    <h2 class="text-lg font-bold text-slate-900">Self-Assessment Quiz Mode</h2>
                    <p class="text-xs text-slate-500">Test your recall! Mark each card as Mastered or Needs Work.</p>
                </div>
                <div class="flex items-center space-x-3">
                    <div class="flex items-center space-x-1.5 bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-bold px-3 py-1.5 rounded-xl">
                        <i class="fa-solid fa-circle-check text-emerald-500"></i>
                        <span>Got It: <span id="score-got-it">0</span></span>
                    </div>
                    <div class="flex items-center space-x-1.5 bg-amber-50 text-amber-700 border border-amber-200 text-xs font-bold px-3 py-1.5 rounded-xl">
                        <i class="fa-solid fa-circle-xmark text-amber-500"></i>
                        <span>Review: <span id="score-needs-practice">0</span></span>
                    </div>
                </div>
            </div>

            <!-- Practice Card -->
            <div id="practice-card-wrapper" class="perspective-1000 w-full h-[340px] sm:h-[380px] cursor-pointer" onclick="flipPracticeCard()">
                <div id="practice-card-inner" class="transform-style-3d relative w-full h-full rounded-3xl shadow-xl transition-all duration-500 bg-white border border-slate-200">
                    
                    <!-- Practice Front -->
                    <div class="backface-hidden absolute inset-0 w-full h-full p-8 flex flex-col justify-between items-center rounded-3xl bg-white">
                        <div class="w-full flex justify-between items-center">
                            <span id="practice-front-pos" class="text-xs font-bold uppercase tracking-wider text-brand-600 bg-brand-50 px-2.5 py-1 rounded-md">Practice Term</span>
                            <span id="practice-counter" class="text-xs font-semibold text-slate-400">1 of 10</span>
                        </div>
                        <div class="text-center px-4 my-auto">
                            <h2 id="practice-front-word" class="text-3xl sm:text-4xl font-extrabold text-slate-900">
                                Practice Word
                            </h2>
                        </div>
                        <div class="text-xs text-slate-400 font-semibold">Click card to reveal definition</div>
                    </div>

                    <!-- Practice Back -->
                    <div class="backface-hidden rotate-y-180 absolute inset-0 w-full h-full p-8 flex flex-col justify-between items-center rounded-3xl bg-slate-900 text-white">
                        <div class="w-full flex justify-between items-center">
                            <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 bg-emerald-950 px-2.5 py-1 rounded-md">Definition</span>
                            <span class="text-xs text-slate-400">Flip back</span>
                        </div>
                        <div class="text-center px-4 my-auto max-h-[220px] overflow-y-auto space-y-2">
                            <p id="practice-back-def" class="text-base sm:text-xl font-medium leading-relaxed text-slate-100">
                                Definition goes here.
                            </p>
                        </div>
                        <div class="text-xs text-slate-400">Did you recall this correctly?</div>
                    </div>

                </div>
            </div>

            <!-- Quiz Grading Buttons -->
            <div id="practice-actions-grid" class="grid grid-cols-2 gap-4">
                <button onclick="markCard(false)" class="py-4 px-6 bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 font-bold rounded-2xl shadow-sm transition-all flex flex-col items-center justify-center space-y-1 active:scale-95">
                    <div class="flex items-center space-x-2 text-amber-600">
                        <i class="fa-solid fa-rotate-left text-lg"></i>
                        <span class="text-base">Needs Practice</span>
                    </div>
                </button>

                <button onclick="markCard(true)" class="py-4 px-6 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-2xl shadow-md shadow-emerald-600/20 transition-all flex flex-col items-center justify-center space-y-1 active:scale-95">
                    <div class="flex items-center space-x-2">
                        <i class="fa-solid fa-circle-check text-lg"></i>
                        <span class="text-base">Got It!</span>
                    </div>
                </button>
            </div>

            <!-- Session Summary Box -->
            <div id="practice-summary" class="hidden bg-white rounded-3xl p-8 border border-slate-200 shadow-xl text-center space-y-6">
                <div class="w-20 h-20 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto text-3xl shadow-inner">
                    <i class="fa-solid fa-trophy"></i>
                </div>
                <div>
                    <h3 class="text-2xl font-extrabold text-slate-900">Quiz Completed!</h3>
                    <p class="text-slate-500 text-sm mt-1">Here are your study results:</p>
                </div>
                
                <div class="grid grid-cols-2 gap-4 max-w-sm mx-auto">
                    <div class="p-4 bg-emerald-50 border border-emerald-100 rounded-2xl">
                        <span class="block text-2xl font-black text-emerald-600" id="summary-got-it">0</span>
                        <span class="text-xs font-bold text-emerald-700 uppercase">Mastered</span>
                    </div>
                    <div class="p-4 bg-amber-50 border border-amber-100 rounded-2xl">
                        <span class="block text-2xl font-black text-amber-600" id="summary-review">0</span>
                        <span class="text-xs font-bold text-amber-700 uppercase">Needs Work</span>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row justify-center gap-3 pt-2">
                    <button onclick="restartPractice(false)" class="px-6 py-3 bg-brand-600 hover:bg-brand-700 text-white font-bold rounded-xl transition-all shadow-md">
                        <i class="fa-solid fa-rotate-right mr-2"></i>Restart Full Deck
                    </button>
                    <button id="btn-review-missed" onclick="restartPractice(true)" class="px-6 py-3 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl transition-all shadow-md hidden">
                        <i class="fa-solid fa-filter mr-2"></i>Review Missed Only
                    </button>
                </div>
            </div>
        </section>

        <!-- VIEW 3: GRID & SEARCH VIEW -->
        <section id="view-grid" class="view-section space-y-6 hidden">
            <!-- Header Bar -->
            <div class="no-print bg-white p-5 rounded-2xl shadow-sm border border-slate-200 flex flex-wrap items-center justify-between gap-4">
                <div class="w-full md:w-auto">
                    <h2 class="text-lg font-bold text-slate-900">Vocabulary Reference Sheet</h2>
                    <p class="text-xs text-slate-500">View all terms, filter definitions, or print study sheets.</p>
                </div>
                <div class="flex items-center space-x-3 w-full md:w-auto">
                    <div class="relative flex-1 md:w-64">
                        <input type="text" id="grid-search-input" onkeyup="renderGridCards()" placeholder="🔍 Filter list..." class="w-full pl-9 pr-4 py-2 bg-slate-50 rounded-xl text-xs font-semibold border border-slate-200 focus:outline-none">
                    </div>
                    <button onclick="window.print()" class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold rounded-xl transition-all flex items-center space-x-2">
                        <i class="fa-solid fa-print"></i>
                        <span>Print</span>
                    </button>
                </div>
            </div>

            <!-- Grid Container -->
            <div id="grid-cards-container" class="print-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                <!-- Dynamic cards -->
            </div>
        </section>

        <!-- VIEW 4: TEACHER EDITOR MODE -->
        <section id="view-editor" class="view-section max-w-4xl mx-auto space-y-6 hidden">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-6">
                <div class="border-b border-slate-100 pb-4 flex items-center justify-between">
                    <div>
                        <div class="flex items-center space-x-2">
