    <!-- Application Module Script -->
    <script type="module">
        // PASSWORD & APP STATE
        const TEACHER_PASSWORD = 'parsons'; // Password requested
        let isTeacherUnlocked = false;

        const PRESET_DECKS = {
            middleSchoolCore: {
                title: "🌟 Middle School Core Vocab",
